<h2><%= title %></h2>
<form method="post">
  <input name="title" value="<%= post?.title || '' %>" placeholder="Title" required>
  <input name="image_url" value="<%= post?.image_url || '' %>" placeholder="Image URL (optional)">
  <textarea name="content" rows="10" placeholder="Content" required><%= post?.content || '' %></textarea>
  <button><%= post ? 'Update' : 'Create' %></button>
</form>
<a href="/admin">← Back</a>
