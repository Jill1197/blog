<h2>Latest Posts</h2>

<!-- AdSense slot (แสดงได้) -->
<div class="ad-slot">
  <!-- AdSense code -->
</div>

<% posts.forEach(p => { %>
  <div class="post">
    <% if (p.image_url) { %>
      <img src="<%= p.image_url %>" alt="<%= p.title %>" class="post-img">
    <% } %>
    <h3><a href="/post/<%= p.slug %>"><%= p.title %></a></h3>
    <p><small>Posted on <%= new Date(p.created_at).toLocaleDateString() %></small></p>
  </div>
<% }) %>
