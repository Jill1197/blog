<h1><%= post.title %></h1>
<p><small>Posted on <%= new Date(post.created_at).toLocaleDateString() %></small></p>

<% if(post.image_url){ %>
  <img src="<%= post.image_url %>" alt="<%= post.title %>" class="post-img">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6975913662182448"
     crossorigin="anonymous"></script>
<% } %>

<!-- AdSense slot -->
<div class="ad-slot">
  <!-- ใส่โค้ด Google AdSense ที่นี่ -->
</div>

<p><%= post.content %></p>
